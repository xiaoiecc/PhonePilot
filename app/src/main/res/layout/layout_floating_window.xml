<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_window_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/capsule_surface"
    app:cardCornerRadius="28dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/capsule_outline"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.kevinluo.autoglm.ui.capsule.CapsuleDragLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_minimize"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="13dp"
                android:src="@drawable/ic_layers"
                app:tint="@color/capsule_accent"
                android:contentDescription="@string/capsule_fold" />
            <View
                android:id="@+id/status_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_indicator_background" />
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:paddingVertical="8dp"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/capsule_ink"
                android:contentDescription="@string/capsule_details"
                android:background="?attr/selectableItemBackground"
                android:paddingEnd="6dp" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_progress_details"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="15dp"
                android:src="@drawable/ic_capsule_expand"
                android:contentDescription="@string/capsule_show_progress"
                app:tint="@color/capsule_muted" />
            <LinearLayout
                android:id="@+id/control_buttons_container"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="48dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pause"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:insetTop="6dp"
                        android:insetBottom="6dp"
                        android:insetLeft="6dp"
                        android:insetRight="6dp"
                        android:contentDescription="@string/pause_task"
                        app:icon="@drawable/ic_pause"
                        app:iconSize="18dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        app:iconTint="@color/capsule_ink"
                        app:backgroundTint="@color/capsule_field"
                        app:cornerRadius="18dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_resume"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:insetTop="6dp"
                        android:insetBottom="6dp"
                        android:insetLeft="6dp"
                        android:insetRight="6dp"
                        android:visibility="gone"
                        android:contentDescription="@string/capsule_continue"
                        app:icon="@drawable/ic_play"
                        app:iconSize="18dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        app:iconTint="@color/capsule_accent"
                        app:backgroundTint="@color/capsule_accent_soft"
                        app:cornerRadius="18dp" />
                </FrameLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_stop"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:insetTop="6dp"
                    android:insetBottom="6dp"
                    android:insetLeft="6dp"
                    android:insetRight="6dp"
                    android:contentDescription="@string/cancel_task"
                    app:icon="@drawable/ic_stop"
                    app:iconSize="18dp"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/capsule_danger"
                    app:backgroundTint="@color/capsule_danger_soft"
                    app:cornerRadius="18dp" />
            </LinearLayout>
        </com.kevinluo.autoglm.ui.capsule.CapsuleDragLayout>
        <ScrollView
            android:id="@+id/capsule_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_step_counter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/capsule_muted"
                        android:textSize="12sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_execution_mode"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/capsule_background"
                        android:textColor="@color/capsule_accent"
                        app:cornerRadius="18dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/capsule_current_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/capsule_ink"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:paddingVertical="8dp"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/capsule_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/capsule_danger"
                    android:visibility="gone"
                    android:paddingVertical="8dp" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/steps_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:clipToPadding="false"
                    android:paddingVertical="4dp"
                    android:overScrollMode="never"
                    android:visibility="gone" />
                <include
                    android:id="@+id/interaction_panel"
                    layout="@layout/layout_floating_interaction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tv_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/capsule_danger"
                    android:textSize="13sp"
                    android:paddingVertical="8dp"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_finish_wait"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/finish_waiting"
                    android:textColor="@color/capsule_accent"
                    app:backgroundTint="@color/capsule_accent_soft"
                    app:cornerRadius="16dp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/input_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:background="@drawable/capsule_field_background"
                    android:padding="4dp">
                    <com.kevinluo.autoglm.ui.capsule.AutoGrowingInput
                        android:id="@+id/task_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:minLines="1"
                        android:maxLines="6"
                        android:background="@null"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:hint="@string/task_input_hint"
                        android:textColor="@color/capsule_ink"
                        android:textColorHint="@color/capsule_muted"
                        android:textSize="15sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:insetTop="6dp"
                        android:insetBottom="6dp"
                        android:insetLeft="6dp"
                        android:insetRight="6dp"
                        android:contentDescription="@string/send_message"
                        app:icon="@drawable/ic_capsule_send"
                        app:iconSize="21dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        app:iconTint="@color/capsule_on_accent"
                        app:backgroundTint="@color/capsule_accent"
                        app:cornerRadius="18dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btn_open_app"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="14dp"
                        android:contentDescription="@string/floating_open_app"
                        android:src="@drawable/ic_open_app"
                        app:tint="@color/capsule_muted" />
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btn_select_template"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="14dp"
                        android:contentDescription="@string/task_select_template"
                        android:src="@drawable/ic_list"
                        app:tint="@color/capsule_muted" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_new_task"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/new_conversation"
                        android:textColor="@color/capsule_accent"
                        android:visibility="gone" />
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btn_close"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="15dp"
                        android:contentDescription="@string/capsule_close"
                        android:src="@drawable/ic_close"
                        app:tint="@color/capsule_muted" />
                </LinearLayout>
                <TextView
                    android:id="@+id/token_usage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/overlay_token_usage_unknown"
                    android:textColor="@color/capsule_muted"
                    android:textSize="11sp"
                    android:paddingEnd="4dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
